    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&lt 3 Q           &kp W           &kp E               &kp R           &kp T       &kp Y      &kp U            &kp I            &kp O            &kp P
&mt LEFT_SHIFT A  &mt LEFT_ALT S  &mt LEFT_CONTROL D  &mt LEFT_GUI F  &kp G       &kp H      &mt RIGHT_GUI J  &mt RCTRL K      &mt RIGHT_ALT L  &mt RIGHT_SHIFT ENTER
&kp Z             &kp X           &kp C               &kp V           &kp B       &kp N      &kp M            &kp COMMA        &kp DOT          &kp FSLH
                                                      &mkp MB1        &mkp MB2    &lt 1 ESC  &kp SPACE        &lt 2 BACKSPACE
            >;
        };

        layer_1 {
            bindings = <
&kp F1          &kp F2     &kp F3        &kp F4    &kp F5     &kp F6     &kp F7            &kp F8         &kp F9     &kp F10
&kp N1          &kp N2     &kp N3        &kp N4    &kp N5     &kp N6     &kp N7            &kp N8         &kp N9     &kp N0
&kp LEFT_SHIFT  &kp LCTRL  &kp LEFT_ALT  &kp CAPS  &kp TAB    &kp MINUS  &kp LEFT_BRACKET  &kp SEMICOLON  &kp COMMA  &kp BACKSLASH
                                         &none     &none      &none      &kp F11           &kp F12
            >;
        };

        layer_2 {
            bindings = <
&none  &none           &none           &none            &none            &none           &kp PAGE_DOWN   &kp PAGE_UP   &none            &none
&none  &none           &kp UP_ARROW    &none            &kp PAGE_UP      &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &none
&none  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp PAGE_DOWN    &kp EQUAL       &kp RBKT        &kp SQT       &kp PERIOD       &kp SLASH
                                       &none            &none            &none           &none           &none
            >;
        };

        layer_3 {
            bindings = <
&none  &none  &none  &none  &none    &none       &none         &none         &none         &none
&none  &none  &none  &none  &none    &bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3
&none  &none  &none  &none  &none    &none       &none         &none         &none         &none
                     &none  &none    &none       &none         &none
            >;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
                        &trans  &trans    &trans  &trans  &trans
            >;
        };
